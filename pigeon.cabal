cabal-version: 3.0
name: pigeon
version: 0.1.0.0
synopsis: Authenticated file publishing with expiring downloads
description:
  Pigeon accepts authenticated uploads, stores them gzip-compressed,
  and publishes them at unguessable URLs with mandatory expiry and
  an optional per-file password.

license: BSD-3-Clause
license-file: LICENSE
author: Philipp Hagenlocher
maintainer: me@philipphagenlocher.de
build-type: Simple
extra-doc-files: CHANGELOG.md
extra-source-files: test/fixtures/pbkdf2-vector.json

common warnings
  ghc-options:
    -Wall

common shared
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DeriveGeneric
    LambdaCase
    MultiWayIf
    NamedFieldPuns
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    TypeApplications

library
  import: warnings, shared
  hs-source-dirs: src
  exposed-modules:
    Pigeon.API
    Pigeon.Client
    Pigeon.Client.Api
    Pigeon.Client.Commands
    Pigeon.Client.Config
    Pigeon.Client.Output
    Pigeon.Config
    Pigeon.Duration
    Pigeon.Password
    Pigeon.Server
    Pigeon.Server.App
    Pigeon.Server.Auth
    Pigeon.Server.Config
    Pigeon.Server.Db
    Pigeon.Server.Env
    Pigeon.Server.Handlers
    Pigeon.Server.Log
    Pigeon.Server.PathSafety
    Pigeon.Server.Storage
    Pigeon.Server.Sweeper
    Pigeon.Server.Web
    Pigeon.Streaming
    Pigeon.Types

  build-depends:
    aeson >=2.1 && <2.4,
    async >=2.2 && <2.3,
    base >=4.18 && <5,
    base64 >=1.0 && <1.1,
    blaze-html >=0.9 && <0.10,
    bytestring >=0.11 && <0.13,
    conduit >=1.3 && <1.4,
    conduit-extra >=1.3 && <1.4,
    containers >=0.6 && <0.9,
    crypton >=1.1 && <1.2,
    crypton-connection >=0.4.6 && <0.5,
    data-default >=0.7 && <0.9,
    directory >=1.3 && <1.4,
    exceptions >=0.10 && <0.11,
    fast-logger >=3.1 && <3.3,
    filepath >=1.4 && <1.6,
    http-client >=0.7 && <0.8,
    http-client-tls >=0.3 && <0.5,
    http-types >=0.12 && <0.13,
    mtl >=2.2 && <2.4,
    optparse-applicative >=0.18 && <0.20,
    password >=3.1 && <3.2,
    primitive >=0.9 && <0.10,
    ram >=0.22 && <0.23,
    resourcet >=1.3 && <1.4,
    safe-exceptions >=0.1 && <0.2,
    servant >=0.20 && <0.21,
    servant-client >=0.20 && <0.21,
    servant-client-core >=0.20 && <0.21,
    servant-conduit >=0.16 && <0.17,
    servant-server >=0.20 && <0.21,
    sqlite-simple >=0.4.19 && <0.5,
    tagged >=0.8 && <0.9,
    text >=2.0 && <2.2,
    time >=1.12 && <1.16,
    tls >=2.3 && <2.4,
    transformers >=0.6 && <0.7,
    ulid >=0.3.3 && <0.4,
    unix >=2.8 && <2.9,
    wai >=3.2 && <3.3,
    wai-extra >=3.1 && <3.2,
    warp >=3.4 && <3.5,
    warp-tls >=3.4 && <3.5,

executable pigeon-server
  import: warnings, shared
  hs-source-dirs: app
  main-is: Server.hs
  build-depends:
    base,
    pigeon,

  -- Use every capability for concurrent gzip/TLS work and give each one a
  -- 16 MiB allocation area to cut minor-GC frequency on streaming paths.
  -- Operators can override with +RTS -Nn, e.g. in cgroup-limited containers.
  ghc-options:
    -threaded
    -rtsopts
    "-with-rtsopts=-N -A16m"

executable pigeon-client
  import: warnings, shared
  hs-source-dirs: app
  main-is: Client.hs
  build-depends:
    base,
    pigeon,

  -- Same runtime defaults as the server so uploads can use parallel GC.
  -- Override with +RTS -N1 in constrained environments.
  ghc-options:
    -threaded
    -rtsopts
    "-with-rtsopts=-N -A16m"

test-suite pigeon-test
  import: warnings, shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    Support

  build-depends:
    aeson,
    async,
    base,
    base64,
    bytestring,
    conduit,
    conduit-extra,
    containers,
    directory,
    filepath,
    hspec >=2.10 && <2.12,
    http-client >=0.7 && <0.8,
    http-types >=0.12 && <0.13,
    pigeon,
    process >=1.6 && <1.7,
    QuickCheck >=2.14 && <2.16,
    resourcet >=1.3 && <1.4,
    safe-exceptions >=0.1 && <0.2,
    servant >=0.20 && <0.21,
    servant-client >=0.20 && <0.21,
    sqlite-simple >=0.4.19 && <0.5,
    temporary >=1.3 && <1.4,
    text,
    time,
    unix,
    wai,
    warp,

  ghc-options:
    -threaded
    -rtsopts
